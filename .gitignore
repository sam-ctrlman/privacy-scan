# git-identity: base (OS files, logs, backups)
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
*:Zone.Identifier
*.log
*.orig
*.sw?

# git-identity: editors (Zed, VS Code, Sublime; TextMate leaves no project folder)
.zed/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-workspace

# >>> git-identity: ai-memory (private agent memory, never tracked; root AGENTS.md stays shared)
.claude/
.gemini/
.codex/
.antigravity/
.agents/
/CLAUDE.md
/CLAUDE.local.md
/GEMINI.md
# <<< git-identity: ai-memory

# /memlayout: credentials — never commit
.env*.local
*.pem
*.key
*.p12
*.pfx
secrets/
*.credentials
*service-account*.json
id_rsa*
id_ed25519*

# /memlayout: project notes stay local (decision D1) — git clean -fdx deletes them
docs/notes/

# git-identity: python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/
/dist/
/build/
